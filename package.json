{
  "name": "u3",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.engine.json && tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run",
    "test:models": "tsx scripts/test-models.ts",
    "smoke": "tsx scripts/smoke.ts",
    "verify": "bash scripts/verify.sh",
    "package": "bash scripts/package.sh",
    "tauri": "tauri"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-node": "1.22.0"
    },
    "onlyBuiltDependencies": [
      "onnxruntime-node"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@huggingface/transformers": "^4.3.1",
    "@remotion/bundler": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "@xzdarcy/react-timeline-editor": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fft.js": "^4.0.4",
    "hono": "^4.13.13",
    "onnxruntime-node": "1.22.0",
    "opentype.js": "^2.0.0",
    "p-queue": "^10.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "19.3.0",
    "remotion": "4.0.529",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "wav": "1.0.2",
    "wavesurfer.js": "^8.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.3",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wav": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "imports": {
    "#components/*": "./src/ui/components/*.tsx",
    "#ui-utils/*": "./src/ui/components/ui/*.ts"
  }
}
