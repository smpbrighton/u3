{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemotionSidecarSpike",
  "version": "0.1.0",
  "identifier": "ai.brightongroup.u3.remotion-sidecar-spike",
  "build": {
    "beforeBuildCommand": "npm run build:frontend && npm run build:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Remotion sidecar spike", "width": 480, "height": 180 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/remotion-sidecar"],
    "resources": ["resources/node", "resources/sidecar.mjs", "resources/chrome-path.txt", "resources/chrome-headless-shell/**/*", "resources/node_modules/**/*", "resources/remotion-bundle/**/*"],
    "macOS": { "signingIdentity": "-" }
  }
}
