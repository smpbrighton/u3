{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "U3",
  "version": "0.2.2",
  "identifier": "ai.brightongroup.u3",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "U3",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNDJCM0VEMUU1MzU4REQKUldUZFdGTWU3Yk5DRVFaajE5eFNKb0lPRXVvTkt0bDdHK1R6YWdRREoxL215a0FVWC8yckI4eXIK",
      "endpoints": [
        "https://github.com/smpbrighton/u3/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
